meta {
  name: Login as admin
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

vars:post-response {
  token: res.body.token
}

docs {
  Needed for GET /api/users. Matches ADMIN_EMAIL and ADMIN_PASSWORD.
}
